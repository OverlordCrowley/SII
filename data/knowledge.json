    "student_laptop": {"parent": "laptop", "slots": {"name": "Учебный ноутбук", "ram_gb": 8}},
    "gaming_pc": {"parent": "desktop", "slots": {"name": "Игровой ПК", "ram_gb": 32}},
    "component": {"parent": "device", "slots": {"category": "компонент"}},
