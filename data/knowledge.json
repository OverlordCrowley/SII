{
  "version": 1,
  "domain": "Предварительная диагностика неисправностей компьютера",
  "symptoms": {
    "power_on": {"label": "Компьютер включается", "true": ["компьютер включается", "включается"], "false": ["компьютер не включается", "не включается"]},
    "fan_spins": {"label": "Вентиляторы вращаются", "true": ["вентиляторы вращаются", "вентилятор крутится"], "false": ["вентиляторы не вращаются", "вентилятор не крутится"]},
    "screen_on": {"label": "Есть изображение на экране", "true": ["есть изображение", "экран работает"], "false": ["нет изображения", "черный экран", "экран не работает"]},
    "beeps": {"label": "Слышны сигналы BIOS", "true": ["пищит", "сигналы bios"], "false": ["не пищит", "нет сигналов bios"]},
    "boot_ok": {"label": "Операционная система загружается", "true": ["система загружается", "windows загружается"], "false": ["система не загружается", "windows не загружается"]},
    "high_temp": {"label": "Компьютер перегревается", "true": ["перегревается", "высокая температура", "сильно греется"], "false": ["не перегревается", "температура нормальная", "не греется"]},
    "fan_loud": {"label": "Вентилятор сильно шумит", "true": ["вентилятор шумит", "кулер шумит"], "false": ["вентилятор не шумит", "кулер не шумит"]},
    "shutdowns": {"label": "Компьютер сам выключается", "true": ["сам выключается", "самопроизвольно выключается"], "false": ["не выключается сам", "нет самопроизвольных выключений"]},
    "slow": {"label": "Компьютер работает медленно", "true": ["тормозит", "работает медленно"], "false": ["не тормозит", "работает быстро"]},
    "disk_noise": {"label": "Диск щелкает или шумит", "true": ["диск щелкает", "диск шумит"], "false": ["диск не щелкает", "диск не шумит"]},
    "disk_errors": {"label": "Появляются ошибки диска", "true": ["ошибки диска", "ошибка диска"], "false": ["нет ошибок диска", "диск без ошибок"]},
    "boot_error": {"label": "Появляется ошибка загрузки", "true": ["ошибка загрузки", "boot device not found"], "false": ["нет ошибки загрузки", "загрузка без ошибок"]},
    "internet_down": {"label": "Интернет не работает", "true": ["нет интернета", "интернет не работает"], "false": ["интернет работает", "интернет есть"]},
    "wifi_disconnected": {"label": "Нет подключения к Wi-Fi", "true": ["wifi не подключен", "wi-fi не подключен", "нет подключения к wifi"], "false": ["wifi подключен", "wi-fi подключен"]},
    "many_apps": {"label": "Открыто много приложений", "true": ["много приложений", "много программ"], "false": ["мало приложений", "мало программ"]},
    "crashes": {"label": "Приложения аварийно завершаются", "true": ["программы вылетают", "приложения вылетают"], "false": ["программы не вылетают", "приложения не вылетают"]},
    "recent_update": {"label": "Недавно установлено обновление", "true": ["после обновления", "недавно обновил"], "false": ["без обновлений", "не обновлял"]},
    "random_restarts": {"label": "Компьютер сам перезагружается", "true": ["сам перезагружается", "случайные перезагрузки"], "false": ["не перезагружается сам", "нет случайных перезагрузок"]}
  },
  "diagnoses": {
    "power_failure": {"label": "Возможная проблема питания", "component": "power_supply", "actions": ["Проверить розетку и подключение кабеля питания.", "При повторении симптомов обратиться в сервис для проверки питания."]},
    "display_failure": {"label": "Возможная проблема монитора или видеосигнала", "component": "monitor", "actions": ["Проверить питание монитора, выбранный вход и кабель изображения.", "Проверить изображение на другом совместимом мониторе."]},
    "ram_failure": {"label": "Возможная проблема оперативной памяти", "component": "ram", "actions": ["Записать последовательность звуковых сигналов.", "Запустить встроенную диагностику памяти, если система загружается.", "При невозможности загрузки передать компьютер специалисту."]},
    "overheating": {"label": "Возможная проблема охлаждения", "component": "cooling", "actions": ["Завершить тяжелые приложения и дать компьютеру остыть.", "Проверить, свободны ли вентиляционные отверстия.", "При повторных выключениях провести диагностику охлаждения в сервисе."]},
    "disk_failure": {"label": "Возможная проблема накопителя", "component": "storage", "actions": ["Если данные доступны, сохранить важные файлы на другом носителе.", "Проверить состояние накопителя диагностической утилитой.", "При щелчках и ошибках чтения обратиться в сервис."]},
    "network_failure": {"label": "Возможная проблема сетевого подключения", "component": "network_adapter", "actions": ["Проверить подключение Wi-Fi или сетевого кабеля.", "Проверить интернет на другом устройстве.", "Проверить состояние роутера и сообщение провайдера о сбое."]},
    "software_issue": {"label": "Возможная программная проблема", "component": "operating_system", "actions": ["Закрыть лишние приложения и проверить нагрузку в диспетчере задач.", "Проверить журналы ошибок и последние обновления.", "Перед восстановлением системы сохранить важные данные."]}
  },
  "rules": [
    {"id": "R01", "if": "NOT power_on AND NOT fan_spins", "then": "power_failure", "priority": 100},
    {"id": "R02", "if": "power_on AND NOT screen_on", "then": "display_problem", "priority": 90},
    {"id": "R03", "if": "display_problem AND beeps", "then": "ram_failure", "priority": 95},
    {"id": "R04", "if": "display_problem AND NOT beeps", "then": "display_failure", "priority": 90},
    {"id": "R05", "if": "high_temp AND (fan_loud OR shutdowns)", "then": "overheating", "priority": 100},
    {"id": "R06", "if": "overheating", "then": "cooling_issue", "priority": 80},
    {"id": "R07", "if": "slow AND (disk_noise OR disk_errors)", "then": "disk_failure", "priority": 95},
    {"id": "R08", "if": "boot_error AND disk_errors", "then": "disk_failure", "priority": 95},
    {"id": "R09", "if": "internet_down AND wifi_disconnected", "then": "network_failure", "priority": 90},
    {"id": "R10", "if": "internet_down AND NOT wifi_disconnected", "then": "router_issue", "priority": 85},
    {"id": "R11", "if": "router_issue", "then": "network_failure", "priority": 80},
    {"id": "R12", "if": "slow AND many_apps AND NOT disk_errors", "then": "software_issue", "priority": 70},
    {"id": "R13", "if": "crashes AND recent_update AND NOT high_temp", "then": "software_issue", "priority": 75},
    {"id": "R14", "if": "beeps AND NOT boot_ok", "then": "ram_failure", "priority": 95},
    {"id": "R15", "if": "random_restarts AND beeps", "then": "ram_failure", "priority": 85},
    {"id": "R16", "if": "high_temp AND random_restarts", "then": "overheating", "priority": 95},
    {"id": "R17", "if": "power_failure", "then": "check_power", "priority": 60},
    {"id": "R18", "if": "display_failure", "then": "check_display", "priority": 60},
    {"id": "R19", "if": "ram_failure", "then": "check_memory", "priority": 60},
    {"id": "R20", "if": "cooling_issue", "then": "check_cooling", "priority": 60},
    {"id": "R21", "if": "disk_failure", "then": "backup_data", "priority": 65},
    {"id": "R22", "if": "network_failure", "then": "check_network", "priority": 60},
    {"id": "R23", "if": "software_issue", "then": "check_software", "priority": 60}
  ],
  "frames": {
    "device": {"parent": null, "slots": {"category": "устройство", "status": "не проверено", "serviceable": true}},
    "computer": {"parent": "device", "slots": {"category": "компьютер", "ram_gb": 8, "os": "Windows", "has_battery": false}},
    "desktop": {"parent": "computer", "slots": {"form_factor": "настольный", "power_source": "сеть"}},
